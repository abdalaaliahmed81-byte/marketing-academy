{
  "name": "marketing-academy",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-backend.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "desktop": "electron .",
    "package:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux dir --publish never",
    "check": "npm run typecheck && npm test && npm run build",
    "api": "node build/server.mjs",
    "audit:project": "node scripts/audit-project.mjs",
    "lint": "node scripts/lint.mjs",
    "package:qa": "node scripts/package-qa.mjs",
    "package:windows:dual": "npm run package:win && npm run package:qa",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:agency": "node scripts/validate-agency.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "main": "electron/main.cjs",
  "description": "أكاديمية التسويق · تعلم وطبّق وابنِ ملف أعمالك",
  "author": "Marketing Academy",
  "build": {
    "appId": "com.marketingacademy.desktop",
    "productName": "Marketing Academy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Marketing-Academy-Portable-Windows-x64.${ext}",
      "signExecutable": false,
      "icon": "public/academy.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Education"
    }
  }
}
